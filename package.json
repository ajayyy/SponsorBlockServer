{
  "name": "sponsor_block_server",
  "version": "0.1.0",
  "description": "Server that holds the SponsorBlock database",
  "main": "src/index.ts",
  "scripts": {
    "test": "ts-node test/test.ts",
    "cover": "nyc npm test",
    "cover:report": "nyc report",
    "dev": "nodemon",
    "dev:bash": "nodemon -x 'npm test ; npm start'",
    "postgres:docker": "docker run --init -it --rm -p 5432:5432 -e POSTGRES_USER=ci_db_user -e POSTGRES_PASSWORD=ci_db_pass postgres:14-alpine",
    "redis:docker": "docker run --init -it --rm -p 6379:6379 redis:7-alpine --save '' --appendonly no",
    "start": "ts-node src/index.ts",
    "tsc": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "author": "Ajay Ramachandran",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "axios": "^1.20.0",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "lz4-napi": "^2.10.0",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.23.1",
    "@types/seedrandom": "^3.0.8",
    "@types/sinon": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.10.0",
    "mocha": "^12.0.1",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-mock-imports": "^1.3.19",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
